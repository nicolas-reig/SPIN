{
  "name": "spin-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:source && npm run test:harness",
    "test:source": "node check-source.mjs",
    "test:harness": "python3 -m unittest discover -s visual -v && node --test \"visual/*.test.mjs\"",
    "test:browser": "node --test \"browser/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
